# OpenClaw Docker 配置 - 简化版
# 所有数据在 E:\AI\openclaw_docker 目录下，让系统自动创建子目录

# -----------------------------------------------------------------------------
# 网关配置
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=你的网关令牌_请替换此默认值
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

#--------------------------------------------------------------------------------------
# GitHub Token（用于技能安装等，可选但推荐）
# 获取地址：https://github.com/settings/tokens
#--------------------------------------------------------------------------------------
GITHUB_TOKEN="ghp_你的 github_token_请替换"

# -----------------------------------------------------------------------------
# 数据持久化路径 - 让系统自动创建子目录
# -----------------------------------------------------------------------------
# 主目录：容器会在 data 目录下自动创建 .openclaw 等目录
OPENCLAW_CONFIG_DIR=E:\AI\openclaw_docker\data

# 工作空间：容器会自动创建 workspace 目录  
OPENCLAW_WORKSPACE_DIR=E:\AI\openclaw_docker\data\workspace

# NPM 全局包：容器会自动创建 node_modules 目录
OPENCLAW_NODE_MODULES_DIR=E:\AI\openclaw_docker\data\node_modules

# -----------------------------------------------------------------------------
# 镜像配置
# -----------------------------------------------------------------------------
# 本地构建镜像（源码部署模式）
OPENCLAW_IMAGE=openclaw-with-go:local

# 如需使用官方镜像，改为：
# OPENCLAW_IMAGE=openclaw/openclaw:latest

# -----------------------------------------------------------------------------
# 构建配置（仅在使用本地镜像时需要）
# -----------------------------------------------------------------------------
OPENCLAW_INSTALL_DOCKER_CLI=1
OPENCLAW_DOCKER_APT_PACKAGES=git curl vim

# -----------------------------------------------------------------------------
# 高级配置（可选）
# -----------------------------------------------------------------------------
# 允许不安全的 WebSocket连接（开发环境）
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=true

# Claude AI 集成（可选）
# CLAUDE_AI_SESSION_KEY=你的 claude_session_key
# CLAUDE_WEB_SESSION_KEY=你的 claude_web_session_key
# CLAUDE_WEB_COOKIE=你的 claude_web_cookie
